<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlexPad.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- FlexPad palette (matches the PowerShell app so the two look like a family).
         Kept in sync with Palette.cs. -->
    <SolidColorBrush x:Key="BgBrush"    Color="#1C1C1E"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2C2C30"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#3C3C42"/>
    <SolidColorBrush x:Key="TextBrush"  Color="#DCDCDC"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB000"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#3CC850"/>
    <SolidColorBrush x:Key="RedBrush"   Color="#EB4646"/>
    <SolidColorBrush x:Key="DimBrush"   Color="#8C8C94"/>
    <SolidColorBrush x:Key="CyanBrush"  Color="#00D2EB"/>
    <!-- App name + FORWARD POWER hero -->
    <SolidColorBrush x:Key="HeroBrush"  Color="#3CC850"/>
    <!-- Forward power bar -->
    <SolidColorBrush x:Key="BlueBrush"  Color="#4A90E2"/>
    <!-- SWR bar (static; the SWR number stays threshold-colored) -->
    <SolidColorBrush x:Key="GoldBrush"  Color="#FFB000"/>
    <!-- Theme accent — same blue the Setup meter-list selection uses (tracks the OS accent). -->
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Fluent draws tabs as large underlined text, which against this dark palette reads as a row of
         labels rather than tabs. Both templates are replaced to get real tab chrome: outlined, rounded
         on top, the selected one filled with the content panel's colour and pulled down 1px so it
         merges into the panel below it. Ported from LP-100A so the two tools match. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="TabItem">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource TrackBrush}"
                  BorderThickness="1,1,1,0"
                  CornerRadius="6,6,0,0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <!-- Overlap the panel border by 1px so the active tab and the panel read as one shape. -->
      <Setter Property="Margin" Value="0,0,3,-1"/>
    </Style>

    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <ItemsPresenter DockPanel.Dock="Top"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="2,0,0,0"/>
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource TrackBrush}"
                    BorderThickness="1"
                    CornerRadius="0,6,6,6"
                    ZIndex="-1">
              <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>

</Application>
