<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlexPad.App.Views.ReferenceWindow"
        Width="820" Height="640" MinWidth="520" MinHeight="300"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app.ico"
        Title="FlexPad — Reference">

  <DockPanel Margin="10">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
      <Button Grid.Column="0" Content="Open the FlexRadio API wiki" Click="OnWikiClick"/>
      <Button Grid.Column="2" Content="Close" Click="OnCloseClick" MinWidth="80"/>
    </Grid>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="4" BorderBrush="{StaticResource TrackBrush}" BorderThickness="1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="10,8">
          <TextBlock x:Name="Body" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"/>
          <TextBlock x:Name="Ports" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AmberBrush}" Margin="0,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
