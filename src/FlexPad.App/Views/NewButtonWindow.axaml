<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlexPad.App.ViewModels"
        xmlns:core="using:FlexPad.Core"
        x:Class="FlexPad.App.Views.NewButtonWindow"
        x:DataType="vm:NewButtonViewModel"
        Width="660" Height="470" CanResize="False"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app.ico"
        Title="FlexPad — New button">

  <DockPanel Margin="16">

    <!-- Buttons for whichever page is showing. Enter takes the default: Next, then Save. -->
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" IsVisible="{Binding IsChoosing}">
        <Button Content="Next" Click="OnNext" MinWidth="90" IsDefault="{Binding IsChoosing}"/>
        <Button Content="Cancel" Click="OnCancel" MinWidth="90" IsCancel="True"/>
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsNaming}">
        <Button Grid.Column="0" Content="Back" Click="OnBack" MinWidth="90"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Content="Edit commands…" Click="OnEdit" ToolTip.Tip="Open the full editor with these commands"/>
          <Button Content="Save" Click="OnSave" MinWidth="90" IsDefault="{Binding IsNaming}"/>
          <Button Content="Cancel" Click="OnCancel" MinWidth="90"/>
        </StackPanel>
      </Grid>
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{StaticResource AmberBrush}" FontSize="12"
               TextWrapping="Wrap" Margin="0,8,0,0"/>

    <Panel>

      <!-- Page one: what should it do? -->
      <StackPanel Spacing="4" IsVisible="{Binding IsChoosing}">
        <TextBlock Text="What should this button do?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <RadioButton GroupName="kind" IsChecked="{Binding IsFrequency, Mode=TwoWay}">
          <StackPanel>
            <TextBlock Text="Go to a frequency"/>
            <TextBlock Text="Tune, mode, both antennas and filter in one press. Filled in from where the radio is now."
                       FontSize="11" Foreground="{StaticResource DimBrush}"/>
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="kind" IsChecked="{Binding IsSnapshot, Mode=TwoWay}">
          <StackPanel>
            <TextBlock Text="Remember what the radio is doing now"/>
            <TextBlock Text="Capture the active slice, or every open slice, exactly as set up." FontSize="11" Foreground="{StaticResource DimBrush}"/>
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="kind" IsChecked="{Binding IsBand, Mode=TwoWay}">
          <StackPanel>
            <TextBlock Text="Change band"/>
            <TextBlock Text="Like a front-panel band button: the radio recalls what it last had on that band." FontSize="11" Foreground="{StaticResource DimBrush}"/>
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="kind" IsChecked="{Binding IsAction, Mode=TwoWay}">
          <StackPanel>
            <TextBlock Text="A common action"/>
            <TextBlock Text="Switch antenna, move TX, pick or close a slice, set power." FontSize="11" Foreground="{StaticResource DimBrush}"/>
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="kind" IsChecked="{Binding IsBlank, Mode=TwoWay}">
          <StackPanel>
            <TextBlock Text="Write the commands myself"/>
            <TextBlock Text="Straight to the editor with an empty command list." FontSize="11" Foreground="{StaticResource DimBrush}"/>
          </StackPanel>
        </RadioButton>

        <!-- The fields for the chosen kind. -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource TrackBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,10,0,0" MinHeight="96">
          <Panel>
            <Grid IsVisible="{Binding IsFrequency}" ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="MHz" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Freq, Mode=TwoWay}" FontFamily="Consolas"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Mode" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
              <TextBlock Grid.Row="0" Grid.Column="4" Text="Step" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding StepChoices}" SelectedItem="{Binding Step, Mode=TwoWay}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Blank leaves the tuning step alone"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="RX ant" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RxAntennas}" SelectedItem="{Binding RxAnt, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="TX ant" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding TxAntennas}" SelectedItem="{Binding TxAnt, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
              <TextBlock Grid.Row="1" Grid.Column="4" Text="Filter" VerticalAlignment="Center"/>
              <Grid Grid.Row="1" Grid.Column="5" ColumnDefinitions="*,4,*">
                <TextBox Grid.Column="0" Text="{Binding FiltLo, Mode=TwoWay}" FontFamily="Consolas"/>
                <TextBox Grid.Column="2" Text="{Binding FiltHi, Mode=TwoWay}" FontFamily="Consolas"/>
              </Grid>
            </Grid>

            <Grid IsVisible="{Binding IsSnapshot}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Top">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Capture" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SnapshotScopes}" SelectedIndex="{Binding SnapshotScope, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="How much" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SnapshotDetails}" SelectedIndex="{Binding SnapshotDetail, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid IsVisible="{Binding IsBand}" ColumnDefinitions="Auto,160,*,Auto" ColumnSpacing="8" VerticalAlignment="Top">
              <TextBlock Grid.Column="0" Text="Band" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Bands}" SelectedItem="{Binding Band, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
              <Button Grid.Column="3" Content="Make a whole row of band buttons…" Click="OnBands" VerticalAlignment="Center"/>
            </Grid>

            <Grid IsVisible="{Binding IsAction}" ColumnDefinitions="Auto,*,Auto,140" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6" VerticalAlignment="Top">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Action" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:ButtonAction"><TextBlock Text="{Binding Name}"/></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ActionParameterLabel}" VerticalAlignment="Center"/>
              <Panel Grid.Row="0" Grid.Column="3">
                <ComboBox ItemsSource="{Binding TxAntennas}" SelectedItem="{Binding ActionValue, Mode=TwoWay}" IsVisible="{Binding ActionTakesAntenna}" HorizontalAlignment="Stretch"/>
                <ComboBox ItemsSource="{Binding SliceLetters}" SelectedItem="{Binding ActionValue, Mode=TwoWay}" IsVisible="{Binding ActionTakesLetter}" HorizontalAlignment="Stretch"/>
                <TextBox Text="{Binding ActionValue, Mode=TwoWay}" IsVisible="{Binding ActionTakesPercent}" FontFamily="Consolas"/>
              </Panel>
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ActionDescription}" FontSize="11" Foreground="{StaticResource DimBrush}"/>
            </Grid>

            <TextBlock IsVisible="{Binding IsBlank}" TextWrapping="Wrap" Foreground="{StaticResource DimBrush}"
                       Text="Next opens the editor. Capture, Insert example and the Reference are all there, and anything the radio's API accepts can go in a button."/>
          </Panel>
        </Border>
      </StackPanel>

      <!-- Page two: name it, and see what it will send. -->
      <Grid IsVisible="{Binding IsNaming}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Name it" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Label" VerticalAlignment="Center" Margin="0,0,10,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LabelBox" Text="{Binding Details.Label, Mode=TwoWay}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hotkey" VerticalAlignment="Center" Margin="0,0,10,6"/>
        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBox Grid.Column="0" Text="{Binding Details.Hotkey, Mode=TwoWay}" PlaceholderText="optional: F1, Ctrl+1, Alt+Shift+X"/>
          <CheckBox Grid.Column="1" Content="Band row (bottom)" IsChecked="{Binding Details.InBandRow, Mode=TwoWay}" Margin="10,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Color" VerticalAlignment="Center" Margin="0,0,10,6"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
          <Border Background="{Binding Details.PreviewBackground}" CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
            <TextBlock Text="Aa" Foreground="{Binding Details.PreviewForeground}"/>
          </Border>
          <ItemsControl ItemsSource="{Binding Details.Swatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:Swatch">
                <Button Width="24" Height="24" Padding="0" Background="{Binding Brush}" CornerRadius="3"
                        Command="{Binding PickCommand}" ToolTip.Tip="{Binding Name}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="x" Width="24" Height="24" Padding="0" Command="{Binding Details.ClearColorCommand}" ToolTip.Tip="No colour" Margin="3,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="THIS BUTTON WILL SEND" FontSize="12" FontWeight="Bold"
                   Foreground="{StaticResource DimBrush}" Margin="0,8,0,4"/>
        <TextBox Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Details.CommandsText, Mode=OneWay}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Top"
                 Focusable="False"/>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
