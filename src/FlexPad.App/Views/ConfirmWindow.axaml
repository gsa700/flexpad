<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlexPad.App.Views.ConfirmWindow"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app.ico"
        Title="Confirm">

  <StackPanel Margin="18,16" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
    <!-- Secondary line for the consequences of the choice; collapsed unless one is supplied. -->
    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="{StaticResource DimBrush}"
               IsVisible="False" FontSize="12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="NegativeButton" Content="Cancel" Click="OnCancel" MinWidth="90"/>
      <Button x:Name="AffirmativeButton" Content="Continue" Click="OnContinue" MinWidth="90"/>
    </StackPanel>
  </StackPanel>
</Window>
