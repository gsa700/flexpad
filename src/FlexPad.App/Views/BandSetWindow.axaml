<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlexPad.App.ViewModels"
        x:Class="FlexPad.App.Views.BandSetWindow"
        x:DataType="vm:BandSetViewModel"
        Width="720" Height="690" CanResize="False"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app.ico"
        Title="FlexPad — Band set">

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,10,0,0">
      <Button Content="Make buttons" Click="OnMake" MinWidth="110" IsDefault="True"/>
      <Button Content="Cancel" Click="OnCancel" MinWidth="90" IsCancel="True"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="SET" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Sets}" SelectedIndex="{Binding SetIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Column="2" Text="RUNS ON" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                   ToolTip.Tip="Which slice these buttons act on"/>
        <ComboBox Grid.Column="3" ItemsSource="{Binding RunsOnChoices}" SelectedItem="{Binding RunsOn, Mode=TwoWay}" MinWidth="130"/>
      </Grid>
      <TextBlock Text="{Binding Blurb}" Foreground="{StaticResource DimBrush}" FontSize="11" TextWrapping="Wrap"/>

      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Column="0" Text="BANDS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="All" Click="OnAll" Margin="0,0,4,0"/>
        <Button Grid.Column="2" Content="None" Click="OnNone"/>
      </Grid>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource TrackBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Height="190">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BandRow">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource DimBrush}"/>
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock Text="ANTENNAS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DimBrush}" Margin="0,6,0,0"/>
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="HF and 6m" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Antennas}" SelectedItem="{Binding HfAntenna, Mode=TwoWay}" IsEnabled="{Binding HfAntennaEnabled}" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Column="2" Text="2m" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="3" ItemsSource="{Binding Antennas}" SelectedItem="{Binding XvtAAntenna, Mode=TwoWay}" IsEnabled="{Binding RecipeEnabled}" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Column="4" Text="70cm" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="5" ItemsSource="{Binding Antennas}" SelectedItem="{Binding XvtBAntenna, Mode=TwoWay}" IsEnabled="{Binding RecipeEnabled}" HorizontalAlignment="Stretch"/>
      </Grid>

      <TextBlock Text="OPTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DimBrush}" Margin="0,6,0,0"/>
      <CheckBox Content="Change band only: the radio recalls what it last had on the band (amateur bands)" IsChecked="{Binding BandChangeOnly, Mode=TwoWay}" IsEnabled="{Binding IsAmateur}"/>
      <CheckBox Content="CW spots and mode instead of phone (labels get a CW suffix)" IsChecked="{Binding Cw, Mode=TwoWay}" IsEnabled="{Binding RecipeEnabled}"/>
      <CheckBox Content="Put them in their own row along the bottom of the window" IsChecked="{Binding BandRow, Mode=TwoWay}"/>
      <CheckBox Content="Assign hotkeys F1 upward, in band order" IsChecked="{Binding Hotkeys, Mode=TwoWay}"/>
      <CheckBox Content="Replace an existing button with the same label instead of adding another" IsChecked="{Binding ReplaceSameLabel, Mode=TwoWay}"/>
    </StackPanel>
  </DockPanel>
</Window>
