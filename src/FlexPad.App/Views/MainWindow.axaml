<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlexPad.App.ViewModels"
        x:Class="FlexPad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="620" Height="360" MinWidth="380" MinHeight="200"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app.ico"
        Title="FlexPad">

  <Panel>
  <DockPanel Margin="12,10">

    <!-- Header, one line: two dots (radio, knob — hover for the address and port), the slice
         status, and the toolbar. The app name is in the title bar already. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
        <Ellipse Width="11" Height="11" Fill="{Binding ConnBrush}" ToolTip.Tip="{Binding ConnTip}"/>
        <TextBlock Text="{Binding RadioLabel}" FontSize="11" Foreground="{StaticResource DimBrush}"
                   VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="{Binding ConnTip}"/>
        <Ellipse Width="11" Height="11" Fill="{Binding KnobBrush}" ToolTip.Tip="{Binding KnobTip}"/>
        <TextBlock Text="{Binding KnobLabel}" FontSize="11" Foreground="{StaticResource DimBrush}"
                   VerticalAlignment="Center" ToolTip.Tip="{Binding KnobTip}"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontFamily="Consolas" FontSize="12"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center">
        <DropDownButton Content="+ Button">
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="New button…" Click="OnAddClick"/>
              <MenuItem Header="Band set…" Click="OnBandSetClick"/>
              <Separator/>
              <MenuItem Header="Pin unpinned buttons to slice A" Click="OnPinAllClick"
                        ToolTip.Tip="Every button that follows the active slice will always run on slice A instead"/>
              <MenuItem Header="Unpin all buttons (follow the active slice)" Click="OnUnpinAllClick"/>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Content="Console" Click="OnConsoleClick"/>
        <Button Content="Reference" Click="OnReferenceClick"/>
        <Button Content="Setup" Click="OnSetupClick"/>
      </StackPanel>
    </Grid>

    <!-- Band row along the bottom: the buttons tagged for it (the band-set generator's output by
         default), one row up to twelve, shorter than the main grid's. -->
    <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasBandRow}">
      <Separator Margin="3,8,3,4" Background="{StaticResource TrackBrush}"/>
      <ItemsControl x:Name="BandRow" ItemsSource="{Binding BandButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).BandColumns}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ButtonViewModel">
            <Button Command="{Binding FireCommand}" Background="{Binding Background}" Foreground="{Binding Foreground}"
                    HorizontalAlignment="Stretch" Margin="3,2" MinHeight="34" Padding="4,2"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="5">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Edit…" Command="{Binding EditCommand}"/>
                  <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"/>
                  <MenuItem Header="Runs on" ItemsSource="{Binding RunsOn}">
                    <MenuItem.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RunsOnChoice">
                        <Setter Property="Header" Value="{Binding Header}"/>
                        <Setter Property="Command" Value="{Binding Command}"/>
                      </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                  </MenuItem>
                  <Separator/>
                  <MenuItem Header="Move earlier" Command="{Binding MoveEarlierCommand}"/>
                  <MenuItem Header="Move later" Command="{Binding MoveLaterCommand}"/>
                  <Separator/>
                  <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
              </Button.ContextMenu>
              <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="12"/>
                  <TextBlock Text="{Binding Hotkey}" HorizontalAlignment="Center" FontSize="9" Opacity="0.75"
                             IsVisible="{Binding HasHotkey}"/>
                </StackPanel>
                <TextBlock Text="{Binding TargetBadge}" IsVisible="{Binding HasTarget}" FontSize="9" FontWeight="Bold" Opacity="0.7"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,1,0"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- The grid. Each button fires its sequence; right-click edits it; drag one onto another to
         rearrange (code-behind). Transparent background so empty space hit-tests as the grid. -->
    <ItemsControl x:Name="MainGrid" ItemsSource="{Binding Buttons}" Margin="0,10,0,0" Background="Transparent">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).Columns}"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ButtonViewModel">
          <Button Command="{Binding FireCommand}" Background="{Binding Background}" Foreground="{Binding Foreground}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" MinHeight="52"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="5">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Edit…" Command="{Binding EditCommand}"/>
                <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"/>
                <MenuItem Header="Runs on" ItemsSource="{Binding RunsOn}">
                  <MenuItem.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RunsOnChoice">
                    <Setter Property="Header" Value="{Binding Header}"/>
                    <Setter Property="Command" Value="{Binding Command}"/>
                  </ControlTheme>
                  </MenuItem.ItemContainerTheme>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Move earlier" Command="{Binding MoveEarlierCommand}"/>
                <MenuItem Header="Move later" Command="{Binding MoveLaterCommand}"/>
                <Separator/>
                <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
              </ContextMenu>
            </Button.ContextMenu>
            <Grid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Text="{Binding Hotkey}" HorizontalAlignment="Center" FontSize="10" Opacity="0.75"
                           IsVisible="{Binding HasHotkey}"/>
              </StackPanel>
              <TextBlock Text="{Binding TargetBadge}" IsVisible="{Binding HasTarget}" FontSize="11" FontWeight="Bold" Opacity="0.7"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0"/>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>

  <!-- Drag ghost lives here, above everything, never hit-tested (code-behind). -->
  <Canvas x:Name="DragLayer" IsHitTestVisible="False"/>
  </Panel>
</Window>
