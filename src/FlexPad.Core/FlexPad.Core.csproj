<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform serial support (Windows COMx, Linux /dev/tty*, macOS).
         Kept in step with the runtime: left at 8.0.0 through the net10 retarget, moved with it here. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

</Project>
